---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import NoteCard from "@/components/NoteCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import getSortedNotes from "@/utils/getSortedNotes";
import config from "@/config";
import { siteExtensions } from "@/site-extensions.config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const notes = await getCollection("notes");
const sortedPosts = getSortedPosts(posts);
const sortedNotes = getSortedNotes(notes);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const recentNotes = sortedNotes.slice(0, siteExtensions.notesPerIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
        <h1 class="text-2xl font-semibold sm:text-3xl">{site.author}</h1>
        <span class="text-sm opacity-80">Stockholm, Sweden</span>
      </div>
      <p class="mt-4">
        I’m an Engineer / Architect / Builder. For more details about me, see
        <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}>About</a
        >.
      </p>
      <p class="mt-2">
        This is a reboot for writing my notes and thoughts online after several
        years of pause.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            {
              "border-border border-b":
                recentNotes.length > 0 || recentPosts.length > 0,
            },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentNotes.length > 0 && (
        <section
          id="recent-notes"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Latest Notes</h2>
          <ul>
            {recentNotes.map(data => (
              <NoteCard variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-4 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "notes")}>
              All Notes
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="mt-4 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              All Posts
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
