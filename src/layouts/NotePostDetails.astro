---
import { render, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import ShareLinks from "@/pages/posts/[...slug]/_components/ShareLinks.astro";
import BackButton from "@/pages/posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "@/pages/posts/[...slug]/_components/BackToTopButton.astro";
import { slugifyStr } from "@/utils/slugify";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

export interface Props {
  post: CollectionEntry<"notes">;
  posts: CollectionEntry<"notes">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  links,
} = post.data;

const { Content } = await render(post);

const layoutProps = {
  title: `${title} | ${config.site.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
};

const locale = Astro.currentLocale ?? config.site.lang;

const allPosts = posts.map(({ data: { title }, id }) => ({
  id,
  title,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);
const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<PostLayout {...layoutProps}>
  <ReadingProgress />
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "app-layout pb-12",
      { "mt-8": !config.features.showBackButton },
    ]}
    data-pagefind-body
  >
    <h1
      transition:name={slugifyStr(title)}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
    </div>
    {
      links && links.length > 0 && (
        <div class="my-3 flex flex-wrap gap-2">
          {links.map(link => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="border-accent/40 text-accent hover:bg-accent/10 inline-flex items-center gap-1 rounded border px-2 py-1 text-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                />
              </svg>
              {link.name}
            </a>
          ))}
        </div>
      )
    }
    <article
      id="article"
      class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mx-auto mt-8"
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getRelativeLocaleUrl(locale, `notes/${prevPost.id}`)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>Previous Note</span>
              <div class="text-accent/85 text-sm">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getRelativeLocaleUrl(locale, `notes/${nextPost.id}`)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>Next Note</span>
              <div class="text-accent/85 text-sm">{nextPost.title}</div>
            </div>
            <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</PostLayout>
